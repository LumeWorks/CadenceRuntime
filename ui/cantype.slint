// Cửa sổ chính CanType. Phiên bản tối thiểu cho commit MSRV: chỉ mở window
// "CanType" 500×400. Tab, settings, tray và binding được thêm ở commit sau.

export component App inherits Window {
    title: "CanType";
    min-width: 500px;
    min-height: 400px;
    preferred-width: 500px;
    preferred-height: 400px;

    HorizontalLayout {
        alignment: center;
        Text {
            text: "CanType";
            font-size: 24px;
            horizontal-alignment: center;
        }
    }
}
