// Cửa sổ chính CanType. 500×400, 3 tab (Cơ bản/Phím tắt/Hệ thống), footer
// [Mặc định][Lưu][Đóng]. Binding config qua in-out properties; callbacks
// `luu`/`mac-dinh`/`dong` cho Rust xử lý.

import { TabWidget, CheckBox, ComboBox, Switch, Button, HorizontalBox,
         VerticalBox, GroupBox } from "std-widgets.slint";

// Tray icon CanType. Component riêng inherits SystemTrayIcon. Icon V/E
// (tiếng Việt bật/tắt), menu với toggle + kiểu gõ + mở cửa sổ + thoát GUI.
export component TrayCanType inherits SystemTrayIcon {
    // `dang-bat` điều khiển icon + menu. Rust set property này.
    in property <bool> dang-bat: true;
    in property <string> kieu-go: "telex";
    callback mo-cua-so();
    callback thoat-giao-dien();
    callback toggle-tieng-viet();
    callback dat-kieu-go(string);

    icon: root.dang-bat ? @image-url("../assets/tray-v.svg")
                        : @image-url("../assets/tray-e.svg");
    tooltip: root.dang-bat ? "CanType - Tiếng Việt" : "CanType - Tiếng Anh";
    visible: true;

    clicked => { root.mo-cua-so(); }

    Menu {
        MenuItem {
            title: root.dang-bat ? "● Tiếng Việt" : "○ Tiếng Việt";
            activated => { root.toggle-tieng-viet(); }
        }
        MenuItem {
            title: root.dang-bat ? "Tiếng Anh" : "● Tiếng Anh";
            activated => { root.toggle-tieng-viet(); }
        }
        MenuItem { title: "────────────"; enabled: false; }
        MenuItem {
            title: "Telex";
            checked: root.kieu-go == "telex";
            activated => { root.dat-kieu-go("telex"); }
        }
        MenuItem {
            title: "VNI";
            checked: root.kieu-go == "vni";
            activated => { root.dat-kieu-go("vni"); }
        }
        MenuItem { title: "────────────"; enabled: false; }
        MenuItem {
            title: "Mở CanType";
            activated => { root.mo-cua-so(); }
        }
        MenuItem {
            title: "Thoát giao diện";
            activated => { root.thoat-giao-dien(); }
        }
    }
}

export component App inherits Window {
    title: "CanType";
    min-width: 500px;
    min-height: 400px;
    preferred-width: 500px;
    preferred-height: 400px;

    // --- In-out properties (config) ---
    in-out property <bool> dang-bat: true;
    in-out property <string> kieu-go: "telex";        // "telex" | "vni"
    in-out property <bool> khoi-dong-cung-he-thong: false;

    // --- In properties (tab Hệ thống, chỉ đọc) ---
    in property <string> phien-lam-viec: "KDE Plasma · X11";
    in property <string> framework-nhap-lieu: "Fcitx5";
    in property <string> trang-thai-addon: "Đã nạp";
    in property <string> trang-thai-im: "Đang hoạt động";
    in property <string> che-do-cai-dat: "Development";
    in property <string> phien-ban-cantype: "0.1.0";
    in property <string> phien-ban-cadence: "v2026.1.0";
    in property <string> sha-cadence: "a5a5863";
    in property <string> trang-thai-tong-quan: "CanType đang hoạt động bình thường";
    in property <bool> khoe-manh: true;

    // --- Callbacks ---
    callback luu();
    callback mac-dinh();
    callback dong();
    callback kiem-tra-lai();

    VerticalBox {
        // --- Header ---
        HorizontalBox {
            padding: 12px;
            Text {
                text: "CanType";
                font-size: 18px;
                font-weight: 700;
            }
            Text {
                text: "Vietnamese typing for Linux";
                font-size: 12px;
                vertical-alignment: center;
                horizontal-alignment: right;
            }
        }

        // --- Tabs ---
        tab-widget := TabWidget {
            // --- Tab Cơ bản ---
            Tab {
                title: "Cơ bản";
                VerticalBox {
                    padding: 16px;
                    spacing: 12px;

                    HorizontalBox {
                        spacing: 8px;
                        Text { text: "Tiếng Việt"; font-size: 14px; }
                        Switch {
                            checked: root.dang-bat;
                            toggled => { root.dang-bat = self.checked; }
                        }
                    }

                    HorizontalBox {
                        spacing: 8px;
                        Text { text: "Bảng mã"; font-size: 14px; }
                        Text {
                            text: "Unicode";
                            font-size: 14px;
                            color: #555;
                        }
                    }

                    HorizontalBox {
                        spacing: 8px;
                        Text { text: "Kiểu gõ"; font-size: 14px; }
                        ComboBox {
                            model: ["Telex", "VNI"];
                            current-value: root.kieu-go == "vni" ? "VNI" : "Telex";
                            selected => {
                                root.kieu-go = self.current-index == 1 ? "vni" : "telex";
                            }
                        }
                    }

                    GroupBox {
                        title: "Khởi động";
                        VerticalBox {
                            CheckBox {
                                text: "Khởi động CanType cùng hệ thống";
                                checked: root.khoi-dong-cung-he-thong;
                                toggled => {
                                    root.khoi-dong-cung-he-thong = self.checked;
                                }
                            }
                        }
                    }
                }
            }

            // --- Tab Phím tắt ---
            Tab {
                title: "Phím tắt";
                VerticalBox {
                    padding: 16px;
                    Text {
                        text: "Phím tắt toàn hệ thống chưa khả dụng trong bản Alpha.";
                        font-size: 13px;
                        wrap: word-wrap;
                    }
                    Text {
                        text: "Đổi tiếng Việt / tiếng Anh qua tab Cơ bản hoặc tray.";
                        font-size: 12px;
                        color: #555;
                    }
                }
            }

            // --- Tab Hệ thống ---
            Tab {
                title: "Hệ thống";
                VerticalBox {
                    padding: 16px;
                    spacing: 6px;

                    Text { text: "Phiên làm việc: " + root.phien-lam-viec; font-size: 13px; }
                    Text { text: "Framework nhập liệu: " + root.framework-nhap-lieu; font-size: 13px; }
                    Text { text: "Addon CanType: " + root.trang-thai-addon; font-size: 13px; }
                    Text { text: "Input method: " + root.trang-thai-im; font-size: 13px; }
                    Text { text: "Chế độ cài đặt: " + root.che-do-cai-dat; font-size: 13px; }
                    Text { text: "CanType: " + root.phien-ban-cantype; font-size: 13px; }
                    Text {
                        text: "Cadence: " + root.phien-ban-cadence + " · " + root.sha-cadence;
                        font-size: 13px;
                    }

                    Rectangle { vertical-stretch: 1; }

                    HorizontalBox {
                        spacing: 6px;
                        // Tròn trạng thái: xanh nếu khỏe, đỏ nếu lỗi.
                        Rectangle {
                            width: 12px; height: 12px;
                            border-radius: 6px;
                            background: root.khoe-manh ? #2e7d32 : #c62828;
                        }
                        Text {
                            text: root.trang-thai-tong-quan;
                            font-size: 13px;
                        }
                    }

                    HorizontalBox {
                        spacing: 8px;
                        padding-top: 8px;
                        Button {
                            text: "Kiểm tra lại";
                            clicked => { root.kiem-tra-lai(); }
                        }
                    }
                }
            }
        }

        // --- Footer ---
        HorizontalBox {
            padding: 12px;
            spacing: 8px;
            Button {
                text: "Mặc định";
                clicked => { root.mac-dinh(); }
            }
            Rectangle { horizontal-stretch: 1; }
            Button {
                text: "Lưu";
                clicked => { root.luu(); }
            }
            Button {
                text: "Đóng";
                clicked => { root.dong(); }
            }
        }
    }
}
