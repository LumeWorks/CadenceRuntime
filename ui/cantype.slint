// CanType — compact native-style desktop utility.
// Visual direction: UniKey-like utility layout, not a dashboard.
// Public properties/callbacks are intentionally kept stable for Rust.

import { Button, CheckBox, ComboBox, Palette }
from "std-widgets.slint";

export component TrayCanType inherits SystemTrayIcon {
    in property <bool> dang-bat: true;
    in property <string> kieu-go: "telex";

    callback mo-cua-so();
    callback thoat-giao-dien();
    callback dat-tieng-viet(bool);
    callback dat-kieu-go(string);

    title: "CanType";
    icon: root.dang-bat ? @image-url("../assets/tray-v.svg")
                        : @image-url("../assets/tray-e.svg");
    tooltip: root.dang-bat
        ? "CanType — Tiếng Việt · " + (root.kieu-go == "vni" ? "VNI" : "Telex")
        : "CanType — Tiếng Anh";
    visible: true;

    clicked => { root.dat-tieng-viet(!root.dang-bat); }

    Menu {
        MenuItem {
            title: root.dang-bat ? "CanType — Tiếng Việt" : "CanType — Tiếng Anh";
            enabled: false;
        }
        MenuSeparator { }
        MenuItem {
            title: "Tiếng Việt";
            checked: root.dang-bat;
            activated => { root.dat-tieng-viet(true); }
        }
        MenuItem {
            title: "Tiếng Anh";
            checked: !root.dang-bat;
            activated => { root.dat-tieng-viet(false); }
        }
        MenuSeparator { }
        MenuItem {
            title: "Telex";
            checked: root.kieu-go == "telex";
            activated => { root.dat-kieu-go("telex"); }
        }
        MenuItem {
            title: "VNI";
            checked: root.kieu-go == "vni";
            activated => { root.dat-kieu-go("vni"); }
        }
        MenuSeparator { }
        MenuItem {
            title: "Mở CanType";
            activated => { root.mo-cua-so(); }
        }
        MenuItem {
            title: "Thoát giao diện";
            activated => { root.thoat-giao-dien(); }
        }
    }
}

export component App inherits Window {
    title: "CanType";

    in-out property <bool> dang-bat: true;
    in-out property <string> kieu-go: "telex";
    in-out property <bool> khoi-dong-cung-he-thong: false;

    in property <string> phien-lam-viec: "KDE Plasma · X11";
    in property <string> trang-thai-framework: "Hoạt động";
    in property <string> trang-thai-addon: "Đã nạp";
    in property <string> phien-ban-cantype: "0.1.0";
    in property <string> phien-ban-cadence: "v2026.1.0";
    in property <string> trang-thai-tong-quan: "CanType đang hoạt động bình thường";
    in property <bool> khoe-manh: true;

    callback luu();
    callback mac-dinh();
    callback dong();
    callback kiem-tra-lai();

    // 0 = compact, 1 = expanded system details
    in-out property <int> tab-hien-tai: 0;

    property <length> compact-height: 292px;
    property <length> expanded-height: 438px;
    property <length> current-height: root.tab-hien-tai == 0
        ? root.compact-height
        : root.expanded-height;

    width: 438px;
    height: root.current-height;
    animate height {
        duration: 180ms;
        easing: ease-in-out;
    }
    background: Palette.background;

    property <brush> border-color: Palette.foreground.with-alpha(0.24);
    property <brush> quiet-text: Palette.foreground.with-alpha(0.68);

    VerticalLayout {
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 12px;
        padding-bottom: 10px;
        spacing: 10px;

        // -------------------------------------------------------------
        // Main control area
        // -------------------------------------------------------------
        HorizontalLayout {
            height: 184px;
            spacing: 10px;

            // GroupBox — Điều khiển
            Rectangle {
                horizontal-stretch: 1;
                border-width: 1px;
                border-color: root.border-color;
                background: transparent;

                Rectangle {
                    x: 9px;
                    y: -2px;
                    width: 72px;
                    height: 17px;
                    background: Palette.background;

                    Text {
                        x: 5px;
                        y: 0px;
                        text: "Điều khiển";
                        font-size: 12px;
                        color: Palette.foreground;
                        vertical-alignment: center;
                    }
                }

                VerticalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    padding-top: 20px;
                    padding-bottom: 11px;
                    spacing: 8px;

                    HorizontalLayout {
                        height: 28px;
                        spacing: 8px;
                        cross-axis-alignment: center;

                        Text {
                            width: 74px;
                            text: "Trạng thái:";
                            font-size: 12px;
                            color: Palette.foreground;
                            vertical-alignment: center;
                        }

                        CheckBox {
                            horizontal-stretch: 1;
                            text: "Bật tiếng Việt";
                            checked: root.dang-bat;
                            toggled => { root.dang-bat = self.checked; }
                        }
                    }

                    HorizontalLayout {
                        height: 28px;
                        spacing: 8px;
                        cross-axis-alignment: center;

                        Text {
                            width: 74px;
                            text: "Bảng mã:";
                            font-size: 12px;
                            color: Palette.foreground;
                            vertical-alignment: center;
                        }

                        ComboBox {
                            horizontal-stretch: 1;
                            model: ["Unicode"];
                            current-index: 0;
                            enabled: false;
                        }
                    }

                    HorizontalLayout {
                        height: 28px;
                        spacing: 8px;
                        cross-axis-alignment: center;

                        Text {
                            width: 74px;
                            text: "Kiểu gõ:";
                            font-size: 12px;
                            color: Palette.foreground;
                            vertical-alignment: center;
                        }

                        ComboBox {
                            horizontal-stretch: 1;
                            model: ["Telex", "VNI"];
                            current-index: root.kieu-go == "vni" ? 1 : 0;
                            selected(value) => {
                                root.kieu-go = value == "VNI" ? "vni" : "telex";
                            }
                        }
                    }

                    HorizontalLayout {
                        height: 28px;
                        spacing: 8px;
                        cross-axis-alignment: center;

                        Text {
                            width: 74px;
                            text: "Khởi động:";
                            font-size: 12px;
                            color: Palette.foreground;
                            vertical-alignment: center;
                        }

                        CheckBox {
                            horizontal-stretch: 1;
                            text: "Cùng hệ thống";
                            checked: root.khoi-dong-cung-he-thong;
                            enabled: false;
                        }
                    }
                }
            }

            // Action column. Deliberately plain/native like UniKey.
            VerticalLayout {
                width: 106px;
                spacing: 7px;

                Button {
                    height: 31px;
                    text: "Lưu";
                    clicked => { root.luu(); }
                }

                Button {
                    height: 31px;
                    text: "Đóng";
                    clicked => { root.dong(); }
                }

                Button {
                    height: 31px;
                    text: "Mặc định";
                    clicked => { root.mac-dinh(); }
                }

                Rectangle { vertical-stretch: 1; }

                Button {
                    height: 31px;
                    text: root.tab-hien-tai == 0 ? "Mở rộng  ›" : "Thu gọn  ‹";
                    clicked => {
                        root.tab-hien-tai = root.tab-hien-tai == 0 ? 1 : 0;
                    }
                }
            }
        }

        // -------------------------------------------------------------
        // Status / system panel. Keep both views alive so expanding and
        // collapsing can cross-fade instead of popping abruptly.
        // -------------------------------------------------------------
        Rectangle {
            height: root.tab-hien-tai == 0 ? 38px : 184px;
            clip: true;
            background: transparent;

            animate height {
                duration: 180ms;
                easing: ease-in-out;
            }

            // Compact status strip
            Rectangle {
                width: parent.width;
                height: 38px;
                opacity: root.tab-hien-tai == 0 ? 1.0 : 0.0;
                border-width: 1px;
                border-color: root.border-color;
                background: transparent;

                animate opacity {
                    duration: 100ms;
                    easing: ease-out;
                }

                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 8px;
                    cross-axis-alignment: center;

                    Text {
                        width: 68px;
                        text: "Hiện tại:";
                        font-size: 11px;
                        color: root.quiet-text;
                        vertical-alignment: center;
                    }

                    Text {
                        horizontal-stretch: 1;
                        text: root.dang-bat
                            ? "Tiếng Việt — " + (root.kieu-go == "vni" ? "VNI" : "Telex")
                            : "Tiếng Anh";
                        font-size: 11px;
                        color: Palette.foreground;
                        vertical-alignment: center;
                    }

                    Text {
                        text: root.khoe-manh ? "Sẵn sàng" : "Có lỗi";
                        font-size: 11px;
                        color: root.khoe-manh ? #2f7d32 : #b3261e;
                        vertical-alignment: center;
                    }
                }
            }

            // Expanded system information
            Rectangle {
                width: parent.width;
                height: 184px;
                opacity: root.tab-hien-tai == 1 ? 1.0 : 0.0;
                border-width: 1px;
                border-color: root.border-color;
                background: transparent;

                animate opacity {
                    duration: 150ms;
                    easing: ease-in-out;
                }

                Rectangle {
                    x: 9px;
                    y: -2px;
                    width: 65px;
                    height: 17px;
                    background: Palette.background;

                    Text {
                        x: 5px;
                        text: "Hệ thống";
                        font-size: 12px;
                        color: Palette.foreground;
                        vertical-alignment: center;
                    }
                }

                VerticalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    padding-top: 21px;
                    padding-bottom: 10px;
                    spacing: 4px;

                    HorizontalLayout {
                        height: 21px;
                        Text {
                            width: 112px;
                            text: "Phiên làm việc:";
                            font-size: 11px;
                            color: root.quiet-text;
                            vertical-alignment: center;
                        }
                        Text {
                            horizontal-stretch: 1;
                            text: root.phien-lam-viec;
                            font-size: 11px;
                            color: Palette.foreground;
                            vertical-alignment: center;
                        }
                    }

                    HorizontalLayout {
                        height: 21px;
                        Text {
                            width: 112px;
                            text: "Framework:";
                            font-size: 11px;
                            color: root.quiet-text;
                            vertical-alignment: center;
                        }
                        Text {
                            horizontal-stretch: 1;
                            text: root.trang-thai-framework;
                            font-size: 11px;
                            color: Palette.foreground;
                            vertical-alignment: center;
                        }
                    }

                    HorizontalLayout {
                        height: 21px;
                        Text {
                            width: 112px;
                            text: "CanType addon:";
                            font-size: 11px;
                            color: root.quiet-text;
                            vertical-alignment: center;
                        }
                        Text {
                            horizontal-stretch: 1;
                            text: root.trang-thai-addon;
                            font-size: 11px;
                            color: Palette.foreground;
                            vertical-alignment: center;
                        }
                    }

                    HorizontalLayout {
                        height: 21px;
                        Text {
                            width: 112px;
                            text: "Phiên bản:";
                            font-size: 11px;
                            color: root.quiet-text;
                            vertical-alignment: center;
                        }
                        Text {
                            horizontal-stretch: 1;
                            text: root.phien-ban-cantype + "  /  " + root.phien-ban-cadence;
                            font-size: 11px;
                            color: Palette.foreground;
                            vertical-alignment: center;
                        }
                    }

                    Rectangle {
                        height: 1px;
                        background: root.border-color.with-alpha(0.7);
                    }

                    HorizontalLayout {
                        height: 34px;
                        spacing: 8px;
                        cross-axis-alignment: center;

                        Text {
                            horizontal-stretch: 1;
                            text: root.trang-thai-tong-quan;
                            font-size: 11px;
                            color: root.khoe-manh ? #2f7d32 : #b3261e;
                            vertical-alignment: center;
                        }

                        Button {
                            width: 102px;
                            height: 28px;
                            text: "Kiểm tra lại";
                            clicked => { root.kiem-tra-lai(); }
                        }
                    }
                }
            }
        }

        Rectangle { vertical-stretch: 1; }

        HorizontalLayout {
            height: 17px;

            Text {
                horizontal-stretch: 1;
                text: "© 2026 Lê Hùng Quang Minh";
                font-size: 10px;
                color: root.quiet-text;
                vertical-alignment: center;
            }

            Text {
                text: "CanType " + root.phien-ban-cantype + " · Cadence " + root.phien-ban-cadence;
                font-size: 10px;
                color: root.quiet-text;
                vertical-alignment: center;
            }
        }
    }
}
